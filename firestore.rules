rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. Sessions Collection
    match /sessions/{sessionId} {
      function isValidSession(data) {
        return data.userId == request.auth.uid 
            && data.fileName is string && data.fileName.size() <= 256
            && data.pages is list && data.pages.size() <= 500
            && data.createdAt is timestamp
            && (data.settings == null || data.settings is map);
      }

      // Simplified read rules
      allow read: if (resource != null && resource.data.get('isShared', false) == true) || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
      
      allow create: if isSignedIn() 
                    && isEmailVerified()
                    && isValidSession(incoming())
                    && incoming().createdAt == request.time;
                    
      allow update: if isSignedIn()
                    && isEmailVerified()
                    && isOwner(existing().userId)
                    && isValidSession(incoming())
                    && incoming().userId == existing().userId
                    && incoming().createdAt == existing().createdAt
                    && (
                      // Action: Edit text or sharing
                      incoming().diff(existing()).affectedKeys().hasOnly(['pages', 'updatedAt', 'settings', 'isShared'])
                    );
                    
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }

    // 2. Voices Collection
    match /voices/{voiceId} {
      function isValidVoice(data) {
        return data.userId == request.auth.uid
            && data.name is string && data.name.size() <= 100
            && data.sampleBase64 is string && data.sampleBase64.size() <= 800000 // approx 600KB base64
            && data.createdAt is timestamp
            && (data.order == null || data.order is number);
      }

      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isEmailVerified() && isValidVoice(incoming()) && incoming().createdAt == request.time;
      allow update: if isSignedIn()
                    && isEmailVerified()
                    && isOwner(existing().userId)
                    && isValidVoice(incoming())
                    && incoming().userId == existing().userId
                    && incoming().createdAt == existing().createdAt
                    && incoming().sampleBase64 == existing().sampleBase64
                    && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'order']);
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }
  }
}
